# Meta generation test outputs — regenerable via backend/generate_avatar.py.
# Keep the small previews/params/manifests as evidence; drop the heavy blobs.
AI-Avatar-Engine/backend/output/**/avatar.glb
AI-Avatar-Engine/backend/output/**/_assembled.blend
AI-Avatar-Engine/meta_avatar/blender/clothing_fit/*.glb

# Animation library — regenerable render/export artifacts. Rebuild via
# animations/scripts/{build_animations,render_previews,export_animations,consolidate_masters}.py.
# Kept in-repo: source (scripts/recipes/plans), the master .blends, the full
# animated GLB, scorecards + FINAL_QA_REPORT + curve-audit JSONs.
AI-Avatar-Engine/animations/previews/
AI-Avatar-Engine/animations/exports/*.fbx
AI-Avatar-Engine/animations/exports/avatar_animated_meta_male_*.glb
AI-Avatar-Engine/animations/qa/reports/*.png
AI-Avatar-Engine/animations/qa/reports/*.csv

# Sandbox avatar bases are served by the API from blender/exports +
# meta_avatar/blender/exports; those GLBs stay tracked as the serving source.
