# Copy this file to .env (same folder) and fill in your key:
#   copy .env.example .env
#
# Used ONLY by the appearance analyzer (hair / beard / glasses / skin tone).
# Geometry analysis is 100% local and works without any key.

OPENAI_API_KEY=sk-...your-key-here...

# Vision model for appearance analysis. gpt-4o-mini is cheap and sufficient;
# use gpt-4o for slightly better hair-style judgement.
OPENAI_MODEL=gpt-4o-mini
